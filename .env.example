# Скопируйте в .env. Секреты не коммитим.
AISKRA_APP_ENV=dev
AISKRA_DATABASE_URL=postgresql+asyncpg://aiskra:aiskra@db:5432/aiskra
AISKRA_AI_CONFIG_PATH=/app/config/ai.yaml
POSTGRES_PASSWORD=aiskra

# Вход (п. 0.3). Начальный администратор создаётся при старте backend, если задан пароль.
# Пароль — не короче 8 символов. После первого входа создайте преподавателей и обучающихся.
AISKRA_BOOTSTRAP_ADMIN_LOGIN=admin
# AISKRA_BOOTSTRAP_ADMIN_PASSWORD=
# AISKRA_SESSION_COOKIE_SECURE=true   # в контуре с TLS
# AISKRA_SESSION_TTL_HOURS=24         # автовыход, как в АРМ-112
# AISKRA_LOGIN_MAX_ATTEMPTS=5
# AISKRA_LOGIN_LOCK_MINUTES=15

# Демо на внешнем API (только для демо-стенда):
# AISKRA_AI_ALLOW_EXTERNAL=true
# DEMO_LLM_URL=https://.../v1
# DEMO_LLM_MODEL=...
# DEMO_LLM_API_KEY=...

# Локальная модель (профиль local-llm):
# LOCAL_LLM_URL=http://ollama:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct

# Скопируйте в .env. Секреты не коммитим.
# Режим окружения (ADR-0015):
#   prod — контур заказчика, по умолчанию в docker compose. Демо-входа и /dev нет, Swagger (/docs) — только
#          вошедшему администратору, логи не подробнее INFO. Запуск ОТКЛОНЯЕТСЯ, если: cookie без Secure,
#          пароль БД пустой или по умолчанию (aiskra), пароль администратора слабый (нужно от 12 символов,
#          3 вида символов из 4, без логина), внешние модели без AISKRA_AI_ALLOW_EXTERNAL=true.
#          Проверить заранее: docker compose run --rm backend python -m aiskra.cli check-config
#   demo — публичный демо-стенд: лента «данные синтетические», вход в роль одной кнопкой; те же проблемы —
#          только предупреждения в лог.
#   dev  — разработка (как demo).
AISKRA_APP_ENV=prod
# Пароль БД: замените «aiskra» — в prod с ним запуск отклоняется. docker compose сам подставит его в адрес БД,
# поэтому без символов @ : / ? # (они ломают адрес).
POSTGRES_PASSWORD=aiskra
AISKRA_AI_CONFIG_PATH=/app/config/ai.yaml
# AISKRA_VERSION=                     # версия в /health (sha коммита); make up подставляет её сама
# AISKRA_LOG_LEVEL=INFO               # в prod DEBUG понижается до INFO

# Вход (п. 0.3). Начальный администратор создаётся при старте backend, если задан пароль.
# Пароль — не короче 8 символов, в prod — не короче 12 и сильный. После первого входа создайте преподавателей
# и обучающихся.
AISKRA_BOOTSTRAP_ADMIN_LOGIN=admin
# AISKRA_BOOTSTRAP_ADMIN_PASSWORD=
# AISKRA_SESSION_COOKIE_SECURE=true   # docker compose задаёт true сам (вход через nginx по HTTPS)
# AISKRA_PROD_ALLOW_HTTP=false        # true — только учебный контур prod без TLS: cookie без Secure (ADR-0015)
# AISKRA_EXPOSE_DOCS=true             # false — /docs и /openapi.json выключены во всех режимах
# AISKRA_SESSION_TTL_HOURS=24         # автовыход, как в АРМ-112
# AISKRA_LOGIN_MAX_ATTEMPTS=5
# AISKRA_LOGIN_LOCK_MINUTES=15

# Демо-стенд (F2, только AISKRA_APP_ENV=demo или dev): учётки teacher, op1, op2, dds1, dds2 из `make demo-seed`.
# AISKRA_DEMO_PASSWORD=                # пароль демо-учёток для demo-seed и demo-history (от 8 символов)
# AISKRA_DEMO_SHOW_PASSWORD=true       # пароль показан на странице входа; false — скрыть
# AISKRA_DEMO_IN_PROD=true             # в prod при заданном AISKRA_DEMO_PASSWORD — демо-учётки на входе; false — нет

# Демо на внешнем API (только для демо-стенда). AISKRA_AI_ALLOW_EXTERNAL=true — явное разрешение внешних моделей:
# без него prod с allow_external: true в конфиге ИИ не запускается.
# AISKRA_AI_ALLOW_EXTERNAL=true
# DEMO_LLM_URL=https://.../v1
# DEMO_LLM_MODEL=...
# DEMO_LLM_API_KEY=...

# Локальная модель (профиль local-llm):
# LOCAL_LLM_URL=http://ollama:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
